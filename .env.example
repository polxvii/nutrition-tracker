# Copy this file to .env and fill in your values. .env is gitignored.
# Full reference: docs/PROJECT_OVERVIEW.md §3 (and docs/ACCOUNT_MIGRATION.md).

# --- Supabase (client-side — needs the VITE_ prefix; these are public) ---
# Supabase Dashboard → Project Settings → API. The anon key is RLS-gated.
# NEVER put the service_role key anywhere in this project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- BYOK master key (SERVER-SIDE — no VITE_ prefix!) ---
# Encrypts each user's own Gemini key at rest (AES-256-GCM). base64 of 32 bytes.
# MUST be identical here and in Cloudflare Pages (as a Secret) — dev and prod
# share one database, so a mismatch makes every stored key undecryptable.
# Generate once:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=

# --- Optional ---
# Override the Gemini model cascade (comma-separated, tried in order).
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest

# NB: GEMINI_API_KEY / GEMINI_API_KEYS are no longer used — users add their own
# key in the app (Settings → "AI — your Gemini key").
